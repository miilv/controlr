OMNIROUTE_BASE_URL=https://omniroute.agent-shipyard.com/v1
OMNIROUTE_API_KEY=sk-...
# OpenRouter, only for the decision head (llm.backend=decisions; omniroute has no decisions route)
OPENROUTER_API_KEY=sk-or-v1-...
# compute3 only: shared secret client <-> Isaac server (unset -> generated per launch)
# CONTROLR_ISAAC_AUTHKEY=
# SO-101 rig: shared secret client <-> so101 server (= ~/.so101_authkey on the rig)
# CONTROLR_SO101_AUTHKEY=
# local shell only (not read from .env): scripts/remote_run.sh passes it as HTTPS_PROXY to the remote controlr
# CONTROLR_LLM_PROXY=http://127.0.0.1:18809
# optional: controlr's own Codex token file (not a .env value; created by scripts/codex_login.py)
# CONTROLR_CODEX_AUTH=~/.controlr/codex_auth.json

# Process configuration for dojo agentic perceive + held_look (export / candidate --setenv;
# the credential dotenv reader reads OMNIROUTE_* only).
# AGENTIC_MODEL=claude/claude-sonnet-5-5
# AGENTIC_HTTP=urllib

# Camera lane process settings (export in the launcher shell; not credential dotenv values).
# LANE_STATE=
# LANE_RUNS=
# LANE_DATA=
# LANE_STREAM=
# LANE_REPO=
# Shared SAM side-service settings (export in the launcher shell; no credentials).
# LANE_SHARED_SAM=sam3
# SAM_PY=/home/USER/controlr-sam/venv/bin/python
# LANE_SAM_LANE_MIB=12288
