[Unit]
Description=controlr VPN (sing-box, machine-wide tun0 + HTTP 10809/18810, SOCKS 10808/18811) — ~/controlr-vpn
Documentation=file:///home/physicalai/controlr-vpn/refresh.py
After=network-online.target
Wants=network-online.target

[Service]
User=root
ExecStart=/home/physicalai/controlr-vpn/bin/sing-box run -c /home/physicalai/controlr-vpn/config.json --disable-color
Restart=always
RestartSec=5
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
