[Unit]
Description=controlr VPN proxy (sing-box, HTTP 127.0.0.1:18810 / SOCKS 18811; no tun) — ~/controlr-vpn
Documentation=file:///home/physicalai/controlr-vpn/refresh.py
After=network-online.target
Wants=network-online.target

[Service]
User=physicalai
ExecStart=/home/physicalai/controlr-vpn/bin/sing-box run -c /home/physicalai/controlr-vpn/config.json --disable-color
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
